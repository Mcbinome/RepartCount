# Copied pattern from gpxlib — MongoDB Atlas on Vercel serverless API
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=repartcount
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Inlined into the Vite client at build time (same value as API_KEY)
VITE_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: leave empty on Vercel (same origin). For local Vite → production API:
# VITE_API_BASE=https://repartcount.vercel.app
